    "backendProcesses": {
      "PROC.STARTUP": {
        "id": "PROC.STARTUP",
        "name": "Открыть сеанс",
        "commands": [
          "connect",
          "getsn"
        ],
        "description": "Открыть сеанс"
      },
      "PROC.SET_WL": {
        "id": "PROC.SET_WL",
        "name": "Установить длину волны",
        "commands": [
          "swl {opt.wavelength_nm}",
          "set measure.zero_required=true"
        ],
        "description": "Установить длину волны"
      },
      "PROC.DARK": {
        "id": "PROC.DARK",
        "name": "Тёмный сигнал",
        "commands": [
          "resetdark"
        ],
        "description": "Тёмный сигнал"
      },
      "PROC.ZERO": {
        "id": "PROC.ZERO",
        "name": "Нулевание",
        "commands": [
          "rezero"
        ],
        "description": "Нулевание"
      },
      "PROC.MEASURE": {
        "id": "PROC.MEASURE",
        "name": "Измерение",
        "commands": [
          "ge 3"
        ],
        "description": "Измерение"
      },
      "PROC.SET_GAIN": {
        "id": "PROC.SET_GAIN",
        "name": "Усиление",
        "commands": [
          "sa {measure.gain}",
          "set measure.zero_required=true"
        ],
        "description": "Усиление"
      },
      "PROC.SET_SWITCH": {
        "id": "PROC.SET_SWITCH",
        "name": "Порог ламп",
        "commands": [
          "setlampwl {opt.lamp_switch_nm}"
        ],
        "description": "Порог ламп"
      },
      "PROC.W_LAMP": {
        "id": "PROC.W_LAMP",
        "name": "Галогенная лампа",
        "commands": [
          "wuon / wuoff"
        ],
        "description": "Галогенная лампа"
      },
      "PROC.D2_LAMP": {
        "id": "PROC.D2_LAMP",
        "name": "Дейтериевая лампа",
        "commands": [
          "d2on / d2off"
        ],
        "description": "Дейтериевая лампа"
      },
      "PROC.WARMUP": {
        "id": "PROC.WARMUP",
        "name": "Прогрев",
        "commands": [
          "getd2",
          "getwu",
          "delay 900000"
        ],
        "description": "Прогрев"
      },
      "PROC.CAL_WL": {
        "id": "PROC.CAL_WL",
        "name": "Калибровка λ",
        "commands": [
          "adjustwl"
        ],
        "description": "Калибровка λ"
      }
    },
