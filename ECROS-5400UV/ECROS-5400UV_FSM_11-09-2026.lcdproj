        "name": {
          "en": "Filter error",
          "ru": "Ошибка фильтра",
          "zh": "滤光片故障"
        },
        "severity": "critical",
        "condition": {
          "kind": "formula",
          "expression": "diag.filter_ok == false",
          "deps": [
