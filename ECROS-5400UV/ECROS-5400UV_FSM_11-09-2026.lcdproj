          ]
        },
        "message": {
          "en": "Filter error",
          "ru": "Ошибка фильтра",
          "zh": "滤光片故障"
        },
        "autoAcknowledge": false
      },
      "ALARM.DETECTOR": {
        "id": "ALARM.DETECTOR",
        "name": {
          "en": "Detector error",
          "ru": "Ошибка детектора",
          "zh": "检测器故障"
        },
        "severity": "critical",
        "condition": {
          "kind": "formula",
          "expression": "diag.detector_ok == false",
          "deps": [
            "diag.detector_ok"
          ]
        },
        "message": {
          "en": "Detector error",
          "ru": "Ошибка детектора",
          "zh": "检测器故障"
        },
        "autoAcknowledge": false
      },
      "ALARM.ZERO": {
        "id": "ALARM.ZERO",
        "name": {
          "en": "New zeroing is required",
          "ru": "Требуется новое нулевание",
          "zh": "需要重新调零"
        },
        "severity": "warning",
        "condition": {
          "kind": "formula",
          "expression": "measure.zero_required == true",
          "deps": [
            "measure.zero_required"
          ]
        },
        "message": {
          "en": "New zeroing is required",
          "ru": "Требуется новое нулевание",
          "zh": "需要重新调零"
        },
        "autoAcknowledge": false
      },
      "ALARM.SATURATION": {
        "id": "ALARM.SATURATION",
        "name": {
          "en": "ADC saturation: reduce gain and zero again",
          "ru": "Насыщение АЦП: уменьшите gain и выполните нулевание",
          "zh": "ADC 饱和：降低增益并重新调零"
        },
        "severity": "critical",
        "condition": {
          "kind": "formula",
          "expression": "fault.saturation == true",
          "deps": [
            "fault.saturation"
          ]
        },
        "message": {
          "en": "ADC saturation: reduce gain and zero again",
          "ru": "Насыщение АЦП: уменьшите gain и выполните нулевание",
          "zh": "ADC 饱和：降低增益并重新调零"
        },
        "autoAcknowledge": false
      },
      "ALARM.LOW_SIGNAL": {
        "id": "ALARM.LOW_SIGNAL",
        "name": {
          "en": "Signal below dark current: result invalid",
          "ru": "Сигнал ниже тёмного: результат недействителен",
          "zh": "信号低于暗电流：结果无效"
        },
        "severity": "critical",
        "condition": {
          "kind": "formula",
          "expression": "fault.signal_low == true",
          "deps": [
