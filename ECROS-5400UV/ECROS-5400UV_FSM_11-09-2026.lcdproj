    "alarms": {
      "ALARM.CLI": {
        "id": "ALARM.CLI",
        "name": {
          "en": "Instrument communication error",
          "ru": "Ошибка обмена с прибором",
          "zh": "仪器通信错误"
        },
        "severity": "critical",
        "condition": {
          "kind": "formula",
          "expression": "fault.cli == true",
          "deps": [
            "fault.cli"
          ]
        },
        "message": {
          "en": "Instrument communication error",
          "ru": "Ошибка обмена с прибором",
          "zh": "仪器通信错误"
        },
        "autoAcknowledge": false
      },
      "ALARM.D2": {
