        "name": {
          "en": "USB storage not detected",
          "ru": "USB-носитель не обнаружен",
          "zh": "未检测到 USB 存储设备"
        },
        "severity": "warning",
        "condition": {
          "kind": "formula",
          "expression": "io.usb_present == false",
          "deps": [
