    "backendProcesses": {
      "PROC.STARTUP": {
        "id": "PROC.STARTUP",
        "name": "Открыть сеанс",
        "commands": [
          "connect",
          "getsn"
        ],
        "description": "Открыть сеанс"
      },
      "PROC.SET_WL": {
        "id": "PROC.SET_WL",
        "name": "Установить длину волны",
        "commands": [
          "swl {opt.wavelength_nm}",
          "set measure.zero_required=true"
        ],
        "description": "Установить длину волны"
      },
      "PROC.DARK": {
        "id": "PROC.DARK",
        "name": "Тёмный сигнал",
        "commands": [
          "resetdark"
        ],
        "description": "Тёмный сигнал"
      },
      "PROC.ZERO": {
        "id": "PROC.ZERO",
        "name": "Нулевание",
        "commands": [
          "rezero"
        ],
        "description": "Нулевание"
      },
      "PROC.MEASURE": {
        "id": "PROC.MEASURE",
        "name": "Измерение",
        "commands": [
          "ge 3"
        ],
        "description": "Измерение"
      },
      "PROC.SET_GAIN": {
        "id": "PROC.SET_GAIN",
        "name": "Усиление",
        "commands": [
          "sa {measure.gain}",
          "set measure.zero_required=true"
        ],
        "description": "Усиление"
      },
      "PROC.SET_SWITCH": {
        "id": "PROC.SET_SWITCH",
        "name": "Порог ламп",
        "commands": [
          "setlampwl {opt.lamp_switch_nm}"
        ],
        "description": "Порог ламп"
      },
      "PROC.W_LAMP": {
        "id": "PROC.W_LAMP",
