          },
          {
            "type": "cli",
            "cliCommandId": "CLI.GET_WU"
          },
          {
            "type": "delay",
            "delayMs": 900000
          }
        ],
        "postcondition": {
          "kind": "tag",
          "tagId": "diag.warmup_complete"
        },
        "failureTargetStateId": null
      },
