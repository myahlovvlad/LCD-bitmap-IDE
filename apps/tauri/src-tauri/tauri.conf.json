{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LCD-bitmap IDE",
  "version": "0.1.2",
  "identifier": "dev.myahlov.lcdbitmapide.tauri",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:renderer",
      "cwd": "../../.."
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LCD-bitmap IDE",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173",
      "capabilities": [
        "desktop"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "LCD and HMI editor for embedded firmware",
    "longDescription": "Cross-platform LCD/HMI editor with firmware exports and spectrophotometer integration.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
